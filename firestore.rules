rules_version = '2';

// Song Ngữ Vật Lí — project Firebase DÙNG CHUNG với app khác (kể cả web Sinh "LOP SONG NGU" — tiền tố lsn_).
// Web Vật lí dùng bộ sưu tập riêng "lsnly_" và claims riêng "ly*" → không đụng dữ liệu/quyền web Sinh.
// KHÔNG deploy nguyên file này bằng "firebase deploy" (sẽ xoá rules của app khác)!
// Dùng "npm run deploy:rules": script chỉ thay phần giữa hai dấu ">>> SONG NGU VAT LI" / "<<< SONG NGU VAT LI"
// trong rules đang chạy. Phần ngoài hai dấu chỉ để chạy test bằng Emulator.
service cloud.firestore {
  match /databases/{database}/documents {

    // >>> SONG NGU VAT LI
    // Mặc định từ chối. Quyền theo claims riêng: lyRole, lySchool, lyClasses.
    // Mọi thao tác ghi lớp/học sinh đi qua API route (firebase-admin) nên client chỉ đọc.
    function lySignedIn() { return request.auth != null; }
    function lyRole() { return request.auth.token.get('lyRole', ''); }
    function lyIsAdmin() { return lySignedIn() && lyRole() == 'admin'; }
    function lyIsTeacher() { return lySignedIn() && lyRole() == 'teacher'; }
    function lyIsStudent() { return lySignedIn() && lyRole() == 'student'; }
    function lySchool() { return request.auth.token.get('lySchool', ''); }
    function lyInMyClasses(classId) { return classId in request.auth.token.get('lyClasses', []); }
    function lyClassData(classId) { return get(/databases/$(database)/documents/lsnly_classes/$(classId)).data; }
    // GV có tên trong teacherIds, hoặc quản trị cùng trường
    function lyIsStaffOf(classId) {
      return (lyIsTeacher() && request.auth.uid in lyClassData(classId).teacherIds)
          || (lyIsAdmin() && lyClassData(classId).schoolId == lySchool());
    }

    match /lsnly_schools/{schoolId} {
      allow read: if lySignedIn() && lySchool() == schoolId;
      allow write: if false;
    }

    match /lsnly_users/{uid} {
      allow read: if lySignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /lsnly_classes/{classId} {
      allow read: if (lyIsTeacher() && request.auth.uid in resource.data.teacherIds)
                  || (lyIsAdmin() && resource.data.schoolId == lySchool())
                  || (lyIsStudent() && lyInMyClasses(classId));
      allow write: if false;

      match /students/{uid} {
        // HS chỉ đọc hồ sơ của chính mình (không thấy tên bạn khác qua client)
        allow read: if lyIsStaffOf(classId)
                    || (lyIsStudent() && lyInMyClasses(classId) && request.auth.uid == uid);
        allow write: if false;
      }
    }

    // Hash PIN — chỉ máy chủ (Admin SDK bỏ qua rules)
    match /lsnly_private/{document=**} {
      allow read, write: if false;
    }

    // Thống kê: chỉ máy chủ ghi; GV lớp và chính HS được đọc
    match /lsnly_studentStats/{id} {
      allow read: if lySignedIn() && (
                    lyIsStaffOf(resource.data.classId)
                    || (lyIsStudent() && resource.data.uid == request.auth.uid));
      allow write: if false;
    }

    // ===== GĐ 2: tiết học & dạy trực tiếp =====
    function lyAnyRole() { return lyIsAdmin() || lyIsTeacher() || lyIsStudent(); }
    function lySess(sid) { return get(/databases/$(database)/documents/lsnly_sessions/$(sid)).data; }

    // Nội dung tiết: GV/quản trị đọc mọi tiết (kể cả nháp); HS chỉ đọc tiết đã duyệt.
    // Đáp án + ghi chú (teacher/*) chỉ GV/quản trị. Ghi tiết chỉ qua API (GĐ 6).
    function lyIsStaff() { return lyIsTeacher() || lyIsAdmin(); }
    match /lsnly_lessons/{lessonId} {
      allow read: if lyIsStaff() || (lyIsStudent() && resource.data.status == 'approved');
      allow write: if false;
      match /slides/{slideId} {
        allow read: if lyIsStaff()
                    || (lyIsStudent() && get(/databases/$(database)/documents/lsnly_lessons/$(lessonId)).data.status == 'approved');
        allow write: if false;
      }
      match /teacher/{slideId} {
        allow read: if lyIsTeacher() || lyIsAdmin();
        allow write: if false;
      }
    }

    match /lsnly_sessions/{sid} {
      allow read: if lyIsStaffOf(resource.data.classId)
                  || (lyIsStudent() && lyInMyClasses(resource.data.classId));
      // GV điều khiển: chỉ được sửa "state" khi tiết đang dạy. Tạo/kết thúc qua API.
      allow update: if lyIsStaffOf(resource.data.classId)
                    && resource.data.status == 'live'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'updatedAt']);
      allow create, delete: if false;

      match /participants/{uid} {
        allow read: if lyIsStaffOf(lySess(sid).classId)
                    || (lyIsStudent() && request.auth.uid == uid);
        allow create: if lyIsStudent() && request.auth.uid == uid
                      && lyInMyClasses(lySess(sid).classId) && lySess(sid).status == 'live'
                      && request.resource.data.keys().hasOnly(['joinedAt', 'lastSeenAt', 'visible', 'leftCount', 'raisedHandAt'])
                      && request.resource.data.get('leftCount', 0) == 0;
        // HS sửa nhịp/rời trang/giơ tay của mình (không được sửa điểm); GV chỉ được hạ tay.
        // Số lần rời trang chỉ được TĂNG (HS không tự xoá được).
        allow update: if (lyIsStudent() && request.auth.uid == uid
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeenAt', 'visible', 'leftCount', 'raisedHandAt'])
                          && request.resource.data.get('leftCount', 0) >= resource.data.get('leftCount', 0))
                      || (lyIsStaffOf(lySess(sid).classId)
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['raisedHandAt']));
        allow delete: if false;
      }

      // Câu trả lời: chỉ máy chủ ghi (chấm điểm); GV đọc cả lớp; HS đọc của mình.
      // Tiết có cờ hideUntilReveal (trang KHTN): HS chỉ đọc được khi tiết đã kết thúc — lúc đang dạy
      // HS xem phiếu "mine" (đúng/sai chỉ có sau khi GV công bố). Tiết không có cờ (trang Toán cũ): như cũ.
      match /responses/{rid} {
        allow read: if lyIsStaffOf(lySess(sid).classId)
                    || (lyIsStudent() && resource.data.uid == request.auth.uid
                        && (lySess(sid).get('hideUntilReveal', false) != true || lySess(sid).status == 'ended'));
        allow write: if false;
      }

      // Phiếu của em: máy chủ ghi (câu đã gửi + kết quả câu đã công bố); HS đọc của mình, GV đọc cả lớp
      match /mine/{uid} {
        allow read: if lyIsStaffOf(lySess(sid).classId)
                    || (lyIsStudent() && request.auth.uid == uid);
        allow write: if false;
      }
      // qstats (bộ đếm xếp hạng): không có quy tắc → chỉ máy chủ đọc/ghi
    }

    // ===== GĐ 4: tin nhắn & thông báo đẩy =====
    function lyMsg(mid) { return get(/databases/$(database)/documents/lsnly_messages/$(mid)).data; }

    // Tin: chỉ máy chủ tạo (kiểm giới hạn + giờ yên lặng). Đọc: HS được nhận, quản trị cùng trường, GV của lớp
    match /lsnly_messages/{mid} {
      allow read: if (lyIsStudent() && request.auth.uid in resource.data.toUids)
                  || (lyIsAdmin() && resource.data.schoolId == lySchool())
                  || lyIsStaffOf(resource.data.classId);
      allow write: if false;

      // Biên nhận của từng em: HS chỉ sửa của mình, chỉ các trường trạng thái / trả lời nhanh
      match /receipts/{uid} {
        allow read: if (lyIsStudent() && request.auth.uid == uid)
                    || (lyIsAdmin() && lyMsg(mid).schoolId == lySchool())
                    || lyIsStaffOf(lyMsg(mid).classId);
        allow update: if lyIsStudent() && request.auth.uid == uid
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'deliveredAt', 'readAt', 'ackAt', 'reply'])
                      && request.resource.data.status in ['sent', 'delivered', 'read', 'acked']
                      && (request.resource.data.reply == null || request.resource.data.reply in ['understood', 'need_help']);
        allow create, delete: if false;
      }
    }

    // Mã thiết bị nhận thông báo đẩy: mỗi người tự quản lý của mình
    match /lsnly_fcmTokens/{uid}/tokens/{tid} {
      allow read, delete: if lySignedIn() && request.auth.uid == uid;
      allow create, update: if lySignedIn() && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly(['token', 'ua', 'updatedAt'])
                            && request.resource.data.token is string && request.resource.data.token.size() <= 4096;
    }

    // ===== GĐ 5: tự học — mọi thao tác ghi đi qua API (máy chủ chấm điểm, chặn gian lận thời gian) =====
    function lyHw(aid) { return get(/databases/$(database)/documents/lsnly_assignments/$(aid)).data; }

    // Ngân hàng thuật ngữ: GV/quản trị đọc tất cả; HS chỉ đọc thuật ngữ đã duyệt
    match /lsnly_terms/{tid} {
      allow read: if lyIsStaff() || (lyIsStudent() && resource.data.status == 'approved');
      allow write: if false;
    }

    // Bài tập về nhà: GV/quản trị của lớp, HS được giao. Không chứa đáp án.
    match /lsnly_assignments/{aid} {
      allow read: if lyIsStaffOf(resource.data.classId)
                  || (lyIsStudent() && request.auth.uid in resource.data.toUids);
      allow write: if false;

      match /submissions/{uid} {
        allow read: if (lyIsStudent() && request.auth.uid == uid)
                    || lyIsStaffOf(lyHw(aid).classId);
        allow write: if false;
      }
    }

    // Thời gian học theo ngày
    match /lsnly_studyDaily/{id} {
      allow read: if (lyIsStudent() && resource.data.uid == request.auth.uid)
                  || lyIsStaffOf(resource.data.classId);
      allow write: if false;
    }

    // Thẻ từ vựng (lịch ôn) — id = uid, nên HS đọc được cả khi chưa có tài liệu
    match /lsnly_cards/{uid} {
      allow read: if (lyIsStudent() && request.auth.uid == uid)
                  || (resource != null && lyIsStaffOf(resource.data.classId));
      allow write: if false;
    }

    // ===== GĐ 6b: lượt dùng trợ lý AI — chỉ máy chủ =====
    match /lsnly_aiUsage/{id} {
      allow read, write: if false;
    }

    // GĐ 3 mới — sự kiện học tập (XP, lên cấp): chỉ máy chủ ghi; HS đọc của mình, GV lớp đọc cả lớp
    match /lsnly_events/{eid} {
      allow read: if (lyIsStudent() && resource.data.uid == request.auth.uid)
                  || lyIsStaffOf(resource.data.classId);
      allow write: if false;
    }

    // GĐ 4 — học liệu (link): GV/quản trị đọc tất cả; HS chỉ đọc học liệu đã duyệt. Ghi qua API.
    match /lsnly_resources/{rid} {
      allow read: if lyIsStaff() || (lyIsStudent() && resource.data.status == 'approved');
      allow write: if false;
    }

    // GĐ 5 — trò chơi: mọi thao tác ghi qua API (máy chủ chấm, tính giờ).
    //   Trạng thái trận (không có đáp án): GV lớp + HS của lớp đọc
    //   Bảng điểm: chỉ GV lớp (tivi + laptop) — HS nhận hạng của mình qua API
    //   Người chơi: chính em + GV lớp · Đáp án (private): không client nào đọc
    match /lsnly_games/{gid} {
      allow read: if lyIsStaffOf(resource.data.classId) || (lyIsStudent() && lyInMyClasses(resource.data.classId));
      allow write: if false;
      match /live/{doc} {
        allow read: if lyIsStaffOf(get(/databases/$(database)/documents/lsnly_games/$(gid)).data.classId);
        allow write: if false;
      }
      match /players/{uid} {
        allow read: if (lyIsStudent() && request.auth.uid == uid)
                    || lyIsStaffOf(get(/databases/$(database)/documents/lsnly_games/$(gid)).data.classId);
        allow write: if false;
      }
      match /private/{doc} {
        allow read, write: if false;
      }
    }

    // Điểm thi đua tuần của lớp: chỉ GV lớp đọc (HS xem bảng qua API, không thấy điểm từng bạn)
    match /lsnly_weekly/{wid} {
      allow read: if resource != null && lyIsStaffOf(resource.data.classId);
      allow write: if false;
    }

    // Ngân hàng câu hỏi: có đáp án → chỉ GV/quản trị đọc (HS nhận câu qua bài tập về nhà). Ghi qua API.
    match /lsnly_questions/{qid} {
      allow read: if lyIsStaff();
      allow write: if false;
    }

    // Dự án STEM: GV lớp + HS của lớp đọc dự án; nhật kí tổ: GV lớp đọc mọi tổ, HS chỉ đọc tổ của mình. Ghi qua API.
    function lyProject(pid) { return get(/databases/$(database)/documents/lsnly_projects/$(pid)).data; }
    match /lsnly_projects/{pid} {
      allow read: if lyIsStaffOf(resource.data.classId) || (lyIsStudent() && lyInMyClasses(resource.data.classId));
      allow write: if false;
      match /teams/{teamNo} {
        allow read: if lyIsStaffOf(lyProject(pid).classId)
                    || (lyIsStudent() && lyInMyClasses(lyProject(pid).classId)
                        && string(get(/databases/$(database)/documents/lsnly_classes/$(lyProject(pid).classId)/students/$(request.auth.uid)).data.team) == teamNo);
        allow write: if false;
      }
    }

    // Cộng đồng học tập: GV lớp đọc tất cả; HS của lớp đọc bài/trả lời ĐÃ DUYỆT + của chính mình. Ghi qua API (kiểm duyệt).
    function lyPost(pid) { return get(/databases/$(database)/documents/lsnly_posts/$(pid)).data; }
    match /lsnly_posts/{pid} {
      allow read: if lyIsStaffOf(resource.data.classId)
                  || (lyIsStudent() && lyInMyClasses(resource.data.classId)
                      && (resource.data.status == 'approved' || resource.data.authorUid == request.auth.uid));
      allow write: if false;
      match /replies/{rid} {
        allow read: if lyIsStaffOf(lyPost(pid).classId)
                    || (lyIsStudent() && lyInMyClasses(lyPost(pid).classId)
                        && (resource.data.status == 'approved' || resource.data.authorUid == request.auth.uid));
        allow write: if false;
      }
    }
    // <<< SONG NGU VAT LI

    // (Chỉ dùng khi test) — rules thật đã có quy tắc chặn mặc định của chúng.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
